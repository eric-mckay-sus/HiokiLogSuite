@typeparam T where T : class, IHiokiLog

@if (Parent != null){
    <div class="col-12 d-flex justify-content-end gap-3">
        <InclusivityControls T="T" />
        <button class="btn btn-outline-secondary" @onclick="Parent.ClearFilters">Clear</button>
        @*Have to use parentheses for RefreshData because it takes an argument now (even though it's optional)*@
        <button class="btn btn-primary" @onclick="() => Parent.RefreshData(force: true, withScroll:true)">Execute</button>
    </div>
}

@code {
    [CascadingParameter]
    public LogTableBase<T> Parent { get; set; } = default!;
}
