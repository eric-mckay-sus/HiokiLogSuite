@page "/upload-logs"

<PageTitle>Upload Hioki Logs</PageTitle>

<h2>Upload Hioki ICT logs</h2>

<p>Upload Hioki ICT log CSVs here to make them searchable in the database.</p>
<Alert Color="AlertColor.Warning" Class="d-inline-block"><Icon Name="IconName.ExclamationDiamond" />
    If duplicates are encountered, they will be skipped.
</Alert>

<div class="centered-container mb-3">
    <div class="upload-card @(isDragging ? "drag-active" : "")">
        <label for="fileInput" class="upload-button">
            <span class="upload-button-content">
                <Icon Name="IconName.CloudArrowUp" Size="IconSize.x2" />
                <span>Choose CSV file</span>
            </span>
            <span class="upload-helper-text">(max 2000 files)</span>
        </label>
        <InputFile id="fileInput" OnChange="HandleFileChanged" accept=".csv" class="hidden-input-overlay" multiple
            @ondragenter="HandleDragEnter"
            @ondragleave="HandleDragLeave"
            @ondragover="HandleDragOver"
            @ondrop="HandleDrop" />
    </div>
</div>

@* Shown when the selected file fails validation *@
<div class="expandable-container">
    <div class="expandable-wrapper @(validationError != null ? "is-expanded" : "")">
        <div class="expandable-content">
            <Alert Color="AlertColor.Danger" Class="mt-3 animate-fade-in d-flex align-items-start justify-content-between">
                <div>
                    <strong><Icon Name="IconName.ExclamationTriangle" /> Invalid file:</strong>
                    @validationError
                </div>
                <button class="btn btn-link" @onclick="() => validationError = null">
                    <Icon Name="IconName.X"/>
                </button>
            </Alert>
        </div>
    </div>
</div>

@* Shown only when the file passes validation *@
<div class="expandable-container">
    <div class="expandable-wrapper @(ConfirmationOpen ? "is-expanded" : "")">
        <div class="expandable-content">
            <Alert Color="AlertColor.Info" Class="mt-3 animate-fade-in shadow-sm">
                <p><strong>Files Selected for Upload </strong>(@selectedFiles.Count):</p>
                <ul class="list-unstyled ms-3">
                    @foreach (IBrowserFile file in selectedFiles)
                    {
                        <li>
                            <Icon Name="IconName.FileEarmarkSpreadsheet" /> @file.Name
                            <span class="text-muted small">(@(file.Size / 1024) KB)</span>
                        </li>
                    }
                </ul>
                <hr />
                <div class="d-flex gap-2">
                    <Button Color="ButtonColor.Success" @onclick='async () => await HandleFileConfirmation()'>
                        <Icon Name="IconName.CloudArrowUpFill" /> Proceed with Upload
                    </Button>
                    <Button Color="ButtonColor.Secondary" @onclick="CancelSelection">
                        Cancel
                    </Button>
                </div>
            </Alert>
        </div>
    </div>
</div>

@* Live progress *@
@if (this.isUploading && this.Reporter?.Progress is { } p)
{
    <div class="centered-container mx-auto w-100">
        <div class="mt-3 w-50">
            @* File counter *@
            <div class="d-flex justify-content-between mb-1">
                <span class="fw-semibold" style="font-size: 1.5rem">
                    @p.CurrentFileName
                    @if (p.IsRepeating)
                    {
                        <span class="badge bg-secondary ms-2">Pass @p.CurrentFilePass</span>
                    }
                </span>
                <span class="text-muted">
                    @p.FilesCompleted of @p.TotalFiles files
                </span>
            </div>

            @* Determinate progress bar driven by file count, not percentage *@
            <div class="progress" style="height: 20px">
                @{ double pct = p.TotalFiles > 0
                       ? (double)p.FilesCompleted / p.TotalFiles * 100
                       : 0; }
                <div class="progress-bar"
                     role="progressbar"
                     style="width: @((int)pct)%; transition: width 0.3s ease;"
                     aria-valuenow="@p.FilesCompleted"
                     aria-valuemin="0"
                     aria-valuemax="@p.TotalFiles"
                     aria-label="@p.FilesCompleted of @p.TotalFiles files processed">
                    @p.FilesCompleted / @p.TotalFiles
                </div>
            </div>

            @* Spinner only while a file is actively being processed *@
            @if (p.FilesCompleted < p.TotalFiles)
            {
                <div class="d-flex align-items-center mt-2 text-muted small">
                    <div class="spinner-border spinner-border-sm me-2" role="status"></div>
                    Processing...
                </div>
            }
        </div>
    </div>
}

@* Post-upload results *@
@if (!isUploading && Reporter?.BatchResults != null && Reporter.BatchResults.Any())
{
    int totalFiles = Reporter.BatchResults.Count;
    int successfulFiles = Reporter.BatchResults.Count(r => !r.hadErrors && !r.alreadyUploaded);
    int duplicateCount = Reporter.BatchResults.Count(r => r.alreadyUploaded);
    int failedCount = Reporter.BatchResults.Count(r => r.hadErrors);
    int totalRows = Reporter.BatchResults.Sum(r => r.rowsUploaded);

    <hr class="my-4" />

    <h3 class="mb-3">Upload Results Summary</h3>

    @* Summary stats Cards *@
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="p-3 border rounded bg-light text-center shadow-sm">
                <div class="text-muted small uppercase">Total Processed</div>
                <div class="fs-4 fw-bold text-dark">@totalFiles</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="p-3 border rounded bg-success-subtle text-center shadow-sm">
                <div class="text-success small uppercase">Rows Written</div>
                <div class="fs-4 fw-bold text-success">@totalRows</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="p-3 border rounded bg-warning-subtle text-center shadow-sm">
                <div class="text-warning-emphasis small uppercase">Skipped Duplicates</div>
                <div class="fs-4 fw-bold text-warning-emphasis">@duplicateCount</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="p-3 border rounded bg-danger-subtle text-center shadow-sm">
                <div class="text-danger small uppercase">Failed Files</div>
                <div class="fs-4 fw-bold text-danger">@failedCount</div>
            </div>
        </div>
    </div>

    @* Duplicates/other issues *@
    @if (duplicateCount > 0 || failedCount > 0)
    {
        <h4 class="text-secondary h5 mb-3">Attention Required / Flagged Items</h4>
        <div class="table-responsive border rounded bg-white shadow-sm">
            <table class="table table-hover align-middle mb-0 small">
                <thead class="table-light">
                    <tr>
                        <th>File Name</th>
                        <th>Barcode ID</th>
                        <th>Status / Issue Location</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var result in Reporter.BatchResults.Where(r => r.hadErrors || r.alreadyUploaded))
                    {
                        <tr>
                            <td class="text-truncate" style="max-width: 250px;" title="@result.file">
                                @Path.GetFileName(result.file)
                            </td>
                            <td>
                                <span class="badge bg-secondary font-monospace" style="font-size: 1rem;">@result.barcode</span>
                            </td>
                            <td>
                                @if (result.alreadyUploaded)
                                {
                                    <span class="text-warning fw-semibold" style="font-size: 1rem;">
                                        <Icon Name="IconName.SkipForwardFill" /> Duplicate Skipped (Time bounds/Barcode already match DB records)
                                    </span>
                                }
                                else if (result.hadErrors)
                                {
                                    <span class="text-danger fw-semibold" style="font-size: 1rem;">
                                        <Icon Name="IconName.XCircle" /> Format Error (Missing required column indices, invalid date configuration, or row properties cut short)
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <Alert Color="AlertColor.Success" Class="d-flex align-items-center shadow-sm">
            <Icon Name="IconName.CheckCircleFill" Class="me-3 fs-4" />
            <div>
                <strong>Perfect upload!</strong> All file packets parsed and uploaded successfully. No formatting anomalies or structural duplicates detected.
            </div>
        </Alert>
    }
}
