@typeparam T where T : class, IHiokiLog
@using HiokiNL2SQLMark1.Logic

@if (TableLogic.TotalCount == 0 && !TableLogic.IsLoading)
{
    <h4 style="text-align: center;">
        No @TableLogic.TableName records found matching these criteria.
    </h4>
}
else
{
    <MasterTable
        Items="TableLogic.DataView"
        CurrentPage="TableLogic.CurrentPage"
        TotalPages="TableLogic.TotalPages"
        TotalCount="TableLogic.TotalCount"
        PageSize="TableLogic.PageSize"
        IsStale="TableLogic.IsStale"
        UIIsStale="TableLogic.UIIsStale"
        IsLoading="TableLogic.IsLoading"
        OnPageChange="TableLogic.ChangePage"
        OnSort="TableLogic.ToggleSort"
        GetSortIcon="TableLogic.GetSortIcon"
        OnPageSizeChange="TableLogic.AlterPageSize"
        OnSaveToCsv="TableLogic.SaveToCSV"
        OnBarcodeClick="TableLogic.HandleBarcodeClick" />
}

@code {
    [Parameter, EditorRequired] 
    public LogTableLogic<T> TableLogic { get; set; } = default!;
}