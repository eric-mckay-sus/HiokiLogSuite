@typeparam TItem
@using System.Reflection
@using System.ComponentModel.DataAnnotations.Schema
@implements IDisposable
@inject PowerSearchLogic GlobalState

@* PAGINATION TOP *@
<div class="pagination-container d-flex justify-content-between align-items-center">
    <div class="d-flex align-items-center">
        <div class="text-muted me-3">Showing @StartRecord to @EndRecord of @TotalCount</div>
        @* Page Size Dropdown *@
        <div class="d-flex align-items-center me-3">
            <span class="text-muted me-2">Rows:</span>
            <select class="form-select form-select-sm" style="width:auto" 
                    @onchange="async (e) => await OnPageSizeChange.InvokeAsync(int.Parse(e.Value.ToString()))">
                <option value="10" selected="@(PageSize == 10)">10</option>
                <option value="25" selected="@(PageSize == 25)">25</option>
                <option value="50" selected="@(PageSize == 50)">50</option>
                <option value="100" selected="@(PageSize == 100)">100</option>
            </select>
        </div>
        <button class="btn btn-outline-success" @onclick="OnSaveToCsv">
            <i class="bi bi-download"></i> Save to CSV
        </button>
    </div>
    <nav>
        <ul class="pagination mt-3">
            <div class="d-flex align-items-center me-3 ms-auto">
                <span class="text-muted me-2">Go to:</span>
                <div class="input-group input-group-sm" style="width: 75px;">
                    <input type="number" class="form-control"
                        min="1" max="@TotalPages" 
                        @bind="jumpPage" 
                        @onkeyup="@(e => e.Key == "Enter" ? HandleJumpPage() : Task.CompletedTask)"
                        placeholder="@CurrentPage" />
                    <button class="btn btn-outline-info btn-sm" @onclick="HandleJumpPage">Go</button>
                </div>
                <span class="text-muted ms-2">of @TotalPages</span>
            </div>
            <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                <button class="btn btn-outline-secondary" @onclick="() => OnPageChange.InvokeAsync(CurrentPage - 1)">&laquo; Previous</button>
            </li>
            <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                <button class="btn btn-primary" @onclick="() => OnPageChange.InvokeAsync(CurrentPage + 1)">Next &raquo;</button>
            </li>
        </ul>
    </nav>
</div>

<div class="table-responsive-wrapper">
    <div class="table-container @(IsLoading ? "loading" : IsStale ? "stale" : "")">
        <div class="res-table-wrapper">
            <table class="table res-table table-striped text-nowrap">
                <thead class="table-dark">
                    <tr>
                        @foreach (PropertyInfo prop in typeof(TItem).GetProperties())
                        {
                            ColumnAttribute? attribute = prop.GetCustomAttribute<ColumnAttribute>();
                            string? displayName = attribute?.Name ?? prop.Name;
                            
                            <th @onclick="() => OnSort.InvokeAsync(prop.Name)" style="cursor:pointer">
                                @displayName @SortIcon(prop.Name)
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    <Virtualize TItem="TItem" Items="@(Items?.ToList())" Context="item" OverscanCount="10">
                        <tr>
                            @foreach (PropertyInfo prop in _cachedProps)
                            {
                                string? value = prop.GetValue(item)?.ToString();
                                if (prop.Name.Equals("Barcode", StringComparison.OrdinalIgnoreCase))
                                {
                                    <td>
                                        <button class="p-0 border-0 text-start font-monospace" 
                                                style="cursor: pointer;"
                                                title="Trace this barcode through all tables"
                                                @onclick='() => OnBarcodeClick.InvokeAsync(value)'>
                                            @value
                                        </button>
                                    </td>
                                }
                                else
                                {
                                    <td>@value</td>
                                }
                            }
                        </tr>
                    </Virtualize>
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    [Parameter] public IEnumerable<TItem>? Items { get; set; }
    private PropertyInfo[] _cachedProps = typeof(TItem).GetProperties();
    
    // Pagination Params
    [Parameter] public int CurrentPage { get; set; }
    [Parameter] public int TotalPages { get; set; }
    [Parameter] public int TotalCount { get; set; }
    [Parameter] public int PageSize { get; set; }
    [Parameter] public EventCallback<int> OnPageChange { get; set; }
    private string jumpPage = "";
    private async Task HandleJumpPage()
    {
        if (int.TryParse(jumpPage, out int targetPage))
        {
            // Clamp the value between 1 and TotalPages
            targetPage = Math.Max(1, Math.Min(targetPage, TotalPages));
            jumpPage = targetPage.ToString(); // Update UI to show clamped value
            await OnPageChange.InvokeAsync(targetPage);
        }
    }

    // Sorting Params
    [Parameter] public string CurrentSortColumn { get; set; } = "";
    [Parameter] public string SortIconString { get; set; } = "↕"; // Logic passed from parent
    [Parameter] public EventCallback<string> OnSort { get; set; }
    
    // Denotes range of records shown
    private int StartRecord => (CurrentPage - 1) * PageSize + 1;
    private int EndRecord => Math.Min(CurrentPage * PageSize, TotalCount);

    // Use the parent's GetSortIcon() to render the arrow
    [Parameter] public Func<string, string> GetSortIcon { get; set; } = (col) => "";
    private string SortIcon(string col) => GetSortIcon?.Invoke(col) ?? "";

    // Save to CSV
    [Parameter] public EventCallback OnSaveToCsv { get; set; }

    // For following a barcode
    [Parameter] public EventCallback<string> OnBarcodeClick { get; set; }

    // For following a barcode
    [Parameter] public EventCallback<int> OnPageSizeChange { get; set; }

    // Whether this table applies to the query primed in the search bar/query builder
    [Parameter] public bool IsStale { get; set; }

    // Whether this table is currently loading
    [Parameter] public bool IsLoading { get; set; }

    protected override void OnInitialized()
    {
        // Subscribe to the global refresh event
        GlobalState.OnRefreshRequested += HandleRefresh;
    }

    private void HandleRefresh()
    {
        // Force the table to re-render with new parameter values
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        GlobalState.OnRefreshRequested -= HandleRefresh;
    }
}