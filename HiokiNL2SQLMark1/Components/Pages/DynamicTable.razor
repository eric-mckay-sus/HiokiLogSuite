@typeparam TItem
@using System.Reflection
@using System.ComponentModel.DataAnnotations.Schema

@if (Items != null && Items.Any())
{
    <div class="table-responsive-wrapper">
        <div class="table-container">
            <div class="res-table-wrapper">
                <table class="table res-table table-striped text-nowrap">
                    <thead class="table-dark">
                        <tr>
                            @foreach (var prop in typeof(TItem).GetProperties())
                            {
                                var attribute = prop.GetCustomAttribute<ColumnAttribute>();
                                var displayName = attribute?.Name ?? prop.Name;
                                <th>@displayName</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Items)
                        {
                            <tr>
                                @foreach (var prop in typeof(TItem).GetProperties())
                                {
                                    <td>@prop.GetValue(item)</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public IEnumerable<TItem>? Items { get; set; }
}