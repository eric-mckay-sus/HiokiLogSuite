@page "/fct"
@rendermode InteractiveServer
@inherits LogTableBase<FctResult> // FCT table is the page type
@inject Logic.FctTableLogic FctLogic // The page is controlled by FCT logic

<PageTitle>Hioki ICT FCT Results</PageTitle>

<h1>Hioki 1220 ICT Functional Test Results</h1>

@* Query Builder Panel *@
<div class="page-content-wrapper" style="max-width: 100%; overflow-x: hidden;">
    <div class="query-builder-panel mb-4 p-3 border rounded bg-light">
        <div class="row g-3">
            <FilterWrapper Filter="Logic.FilterBarcode" Label="Barcode" ColumnClass="col-2">
                <input type="text" class="form-control" @bind="Logic.FilterBarcode.Value" placeholder="Scan or type..." />
            </FilterWrapper>
            <div class="col-2">
                <label class="form-label fw-bold">Start Date</label>
                <div @key="Logic.FilterStartDate">
                    <input type="date" class="form-control" @bind="Logic.FilterStartDate.Value" />
                </div>
            </div>
            <div class="col-2">
                <label class="form-label fw-bold">End Date</label>
                <div @key="Logic.FilterEndDate">
                    <input type="date" class="form-control" @bind="Logic.FilterEndDate.Value" />
                </div>
            </div>
            <FilterWrapper Filter="Logic.FilterGroup" Label="Group #" ColumnClass="col-1">
                <input type="number" class="form-control" step="1" @bind="Logic.FilterGroup.Value" />
            </FilterWrapper>
            <FilterWrapper Filter="FctLogic.FilterStep" Label="Step #" ColumnClass="col-1">
                <input type="number" class="form-control" step="1" @bind="FctLogic.FilterStep.Value" />
            </FilterWrapper>
            <FilterWrapper Filter="FctLogic.FilterMode" Label="Test Mode" ColumnClass="col-2">
                <select class="form-select" @bind="FctLogic.FilterMode.Value">
                    <option value="">All Modes</option>
                    @foreach (string? m in Logic.modeCache)
                    {
                        <option value="@m">@m</option>
                    }
                </select>
            </FilterWrapper>
            <FilterWrapper Filter="Logic.FilterResult" Label="Result" ColumnClass="col-2">
                <select class="form-select" @bind="Logic.FilterResult.Value">
                    <option value="">All Results</option>
                    @foreach (string? r in Logic.resultCache)
                    {
                        <option value="@r">@r</option>
                    }
                </select>
            </FilterWrapper>
            <div class="col-12 d-flex justify-content-end gap-2">
                <button class="btn btn-outline-secondary" @onclick="ClearFilters">Clear</button>
                <button class="btn btn-primary" @onclick="() => RefreshData()">Execute</button>
            </div>
        </div>
    </div>
</div>

@if (!DataView.Any())
{
    <h4 style="text-align: center;">No FCT records found matching these criteria.</h4>
}
else
{
    <MasterTable TItem="FctResult" 
            Items="DataView"
            CurrentPage="Logic.CurrentPage"
            TotalPages="Logic.TotalPages"
            TotalCount="Logic.TotalCount"
            PageSize="Logic.PageSize"
            OnPageChange="ChangePage"
            CurrentSortColumn="@Logic.CurrentSortColumn"
            OnSort="ToggleSort"
            GetSortIcon="GetSortIcon"
            OnSaveToCsv="Logic.SaveToCSV" 
            OnBarcodeClick="Logic.HandleBarcodeClick" />
}

@code {
    /// <summary>
    /// When the page is opened, tell LogTableBase that it is a FCT table page
    /// </summary>
    protected override void OnInitialized()
    {
        base.Logic = FctLogic;
    }
}