@page "/group"
@using Microsoft.EntityFrameworkCore.Metadata.Conventions
@rendermode InteractiveServer

@inherits LogTableBase<GroupResult>

<PageTitle>Group Results</PageTitle>

<h1>Hioki 1220 ICT Group Test Results</h1>

<div class="query-builder-panel mb-4 p-3 border rounded bg-light  style="max-width: 100%; overflow-x: hidden;">
    <div class="row g-3">
        <div class="col-3">
            <label class="form-label fw-bold">Barcode</label>
            <input type="text" class="form-control" @bind="filterBarcode" placeholder="Scan or type..." />
        </div>
        <div class="col-3">
            <label class="form-label fw-bold">Start Date</label>
            <input type="date" class="form-control" @bind="filterStartDate" />
        </div>
        <div class="col-3">
            <label class="form-label fw-bold">End Date</label>
            <input type="date" class="form-control" @bind="filterEndDate" />
        </div>
        <div class="col-1">
                <label class="form-label fw-bold">Group</label>
                <input type="number" class="form-control" step="1" @bind="filterGroup" />
            </div>
        <div class="col-2">
            <label class="form-label fw-bold">Overall Result</label>
            <select class="form-select" @bind="filterResult">
                <option value="">All Results</option>
                <option value="PASS">PASS</option>
                <option value="FAIL">FAIL</option>
            </select>
        </div>
        <div class="col-12 d-flex justify-content-end gap-2">
            <button class="btn btn-outline-secondary" @onclick="ClearFilters">Clear</button>
            @*Make sure to use parentheses for RefreshData because it takes an argument now (even though it's optional)*@
            <button class="btn btn-primary" @onclick="() => RefreshData()">Execute</button>
        </div>
    </div>
</div>

@if (DataView == null)
{
    <p><em>Loading data from SQL...</em></p>
}
else if (!DataView.Any())
{
    <p>No group records found matching these criteria.</p>
}
else
{
    <MasterTable TItem="GroupResult" 
              Items="DataView"
              CurrentPage="currentPage"
              TotalPages="TotalPages"
              TotalCount="totalCount"
              PageSize="pageSize"
              OnPageChange="ChangePage"
              CurrentSortColumn="@currentSortColumn"
              OnSort="ToggleSort"
              GetSortIcon="GetSortIcon" />
}

@code {
    /// <summary>
    /// When the page loads, checks the available result types and modes, then performs the default query
    /// </summary>
    /// <returns></returns>
    protected override async Task OnInitializedAsync()
    {
        await RefreshData();
    }

    /// <summary>
    /// Sets the base query to GroupView so LogTableBase.cs can take over
    /// </summary>
    /// <returns>A fresh IQueryable<GroupResult></returns>
    protected override IQueryable<GroupResult> GetBaseQuery() => Db.GroupView;
}