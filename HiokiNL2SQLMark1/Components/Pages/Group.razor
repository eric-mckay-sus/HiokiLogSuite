@page "/group"
@using Microsoft.EntityFrameworkCore.Metadata.Conventions
@rendermode InteractiveServer

@inherits LogTableBase<GroupResult>

<PageTitle>Group Results</PageTitle>

<h1>Hioki 1220 ICT Group Test Results</h1>

<div class="query-builder-panel mb-4 p-3 border rounded bg-light  style="max-width: 100%; overflow-x: hidden;">
    <div class="row g-3">
        <div class="col-3">
            <label class="form-label fw-bold">Barcode</label>
            <input type="text" class="form-control" @bind="filterBarcode" placeholder="Scan or type..." />
        </div>
        <div class="col-3">
            <label class="form-label fw-bold">Start Date</label>
            <input type="date" class="form-control" @bind="filterStartDate" />
        </div>
        <div class="col-3">
            <label class="form-label fw-bold">End Date</label>
            <input type="date" class="form-control" @bind="filterEndDate" />
        </div>
        <div class="col-1">
                <label class="form-label fw-bold">Group</label>
                <input type="number" class="form-control" step="1" @bind="filterGroup" />
            </div>
        <div class="col-2">
            <label class="form-label fw-bold">Overall Result</label>
            <select class="form-select" @bind="filterResult">
                <option value="">All Results</option>
                <option value="PASS">PASS</option>
                <option value="FAIL">FAIL</option>
            </select>
        </div>
        <div class="col-12 d-flex justify-content-end gap-2">
            <button class="btn btn-outline-secondary" @onclick="ClearFilters">Clear</button>
            @*Make sure to use parentheses for RefreshData because it takes an argument now (even though it's optional)*@
            <button class="btn btn-primary" @onclick="() => RefreshData()">Execute</button>
        </div>
    </div>
</div>

@if (DataView == null)
{
    <p><em>Loading data from SQL...</em></p>
}
else if (!DataView.Any())
{
    <p>No group records found matching these criteria.</p>
}
else
{
    @* One for the top, and one for the bottom to ensure visibility*@
    <div class="pagination mt-3 mb-5 d-flex justify-content-between align-items-center gap-2">
        <div class="text-muted" style="font-size: 0.85rem;">
            Showing <strong>@((currentPage - 1) * pageSize + 1)</strong> to 
            <strong>@(Math.Min(currentPage * pageSize, totalCount))</strong> of 
            <strong>@totalCount</strong> results
        </div>

        <nav aria-label="Page navigation">
            <ul class="pagination mb-0">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <button class="btn btn-outline-secondary" @onclick="() => ChangePage(currentPage - 1)">
                        <span aria-hidden="true">&laquo;</span> Previous
                    </button>
                </li>

                <li class="page-item @(currentPage == TotalPages ? "disabled" : "")">
                    <button class="btn btn-primary" @onclick="() => ChangePage(currentPage + 1)">
                        Next Page <span aria-hidden="true">&raquo;</span>
                    </button>
                </li>
            </ul>
        </nav>
    </div>
    <div class="table-responsive-wrapper">
        <div class="table-container">
            <div class="res-table-wrapper">
                <table class="table res-table table-striped text-nowrap">
                    <thead>
                        <tr>
                            <th @onclick='() => ToggleSort("Barcode")' style="cursor:pointer">Barcode @(GetSortIcon("Barcode"))</th>
                            <th @onclick='() => ToggleSort("Time")' style="cursor:pointer">Time @(GetSortIcon("Time"))</th>
                            <th @onclick='() => ToggleSort("Group")' style="cursor:pointer">Group @(GetSortIcon("Group"))</th>
                            <th># of times tested</th>
                            <th>Overall Result</th>
                            <th>Component Test</th>
                            <th>Short Test</th>
                            <th>Open Test</th>
                            <th>IC Test</th>
                            <th>Macro Test</th>
                            <th>Function Test</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (GroupResult item in DataView)
                        {
                            <tr>
                                <td>@item.Barcode</td>
                                <td>@item.Time</td>
                                <td>@item.Group</td>
                                <td>@item.TimesTested</td>
                                <td class="fw-bold">@item.Result</td>
                                <td>@item.ComponentTest</td>
                                <td>@item.ShortTest</td>
                                <td>@item.OpenTest</td>
                                <td>@item.IcTest</td>
                                <td>@item.MacroTest</td>
                                <td>@item.FunctionTest</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    @* One for the top, and one for the bottom to ensure visibility*@
    <div class="pagination-container d-flex justify-content-between align-items-center mb-3">
        <div class="text-muted" style="font-size: 0.85rem;">
            Showing <strong>@((currentPage - 1) * pageSize + 1)</strong> to 
            <strong>@(Math.Min(currentPage * pageSize, totalCount))</strong> of 
            <strong>@totalCount</strong> results
        </div>

        <nav aria-label="Page navigation">
            <ul class="pagination mb-0">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <button class="btn btn-outline-secondary" @onclick="() => ChangePage(currentPage - 1)">
                        &laquo; Previous
                    </button>
                </li>

                <li class="page-item @(currentPage == TotalPages ? "disabled" : "")">
                    <button class="btn btn-primary" @onclick="() => ChangePage(currentPage + 1)">
                        Next Page &raquo;
                    </button>
                </li>
            </ul>
        </nav>
    </div>
}

@code {
    /// <summary>
    /// When the page loads, checks the available result types and modes, then performs the default query
    /// </summary>
    /// <returns></returns>
    protected override async Task OnInitializedAsync()
    {
        await RefreshData();
    }

    /// <summary>
    /// Sets the base query to GroupView so LogTableBase.cs can take over
    /// </summary>
    /// <returns>A fresh IQueryable<GroupResult></returns>
    protected override IQueryable<GroupResult> GetBaseQuery() => Db.GroupView;
}