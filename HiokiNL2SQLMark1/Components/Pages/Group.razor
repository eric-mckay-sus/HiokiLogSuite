@page "/group"
@rendermode InteractiveServer
@inherits LogTableBase<GroupResult> // Group table is the page type
@inject Logic.GroupTableLogic GroupLogic // The page is controlled by group logic

<PageTitle>Hioki ICT Group Results</PageTitle>

<h1>Hioki 1220 ICT Group Test Results</h1>

<div class="page-content-wrapper" style="max-width: 100%; overflow-x: hidden;">
    <div class="query-builder-panel mb-4 p-3 border rounded bg-light style="max-width: 100%; overflow-x: hidden;">
        <div class="row g-3">
                <FilterWrapper Filter="Logic.FilterBarcode" Label="Barcode" ColumnClass="col-3">
                    <input type="text" class="form-control" @bind="Logic.FilterBarcode.Value" placeholder="Scan or type..." />
                </FilterWrapper>
            <div class="col-3">
                <label class="form-label fw-bold">Start Date</label>
                <div @key="Logic.FilterStartDate">
                    <input type="date" class="form-control" @bind="Logic.FilterStartDate.Value" />
                </div>
            </div>
            <div class="col-3">
                <label class="form-label fw-bold">End Date</label>
                <div @key="Logic.FilterEndDate">
                    <input type="date" class="form-control" @bind="Logic.FilterEndDate.Value" />
                </div> 
            </div>
            <FilterWrapper Filter="Logic.FilterGroup" Label="Group #" ColumnClass="col-1">
                <input type="number" class="form-control" @bind="Logic.FilterGroup.Value" />
            </FilterWrapper>
            <FilterWrapper Filter="Logic.FilterResult" Label="Overall Result" ColumnClass="col-2">
                <select class="form-select" @bind="Logic.FilterResult.Value">
                    <option value="">All Results</option>
                    <option value="PASS">PASS</option>
                    <option value="FAIL">FAIL</option>
                </select>
            </FilterWrapper>
            <FilterWrapper Filter="GroupLogic.FilterComp" Label="Component Test Result" ColumnClass="col-2">
                <select class="form-select" @bind="GroupLogic.FilterComp.Value">
                    <option value="">All Results</option>
                    <option value="PASS">PASS</option>
                    <option value="FAIL">FAIL</option>
                </select>
            </FilterWrapper>
            <FilterWrapper Filter="GroupLogic.FilterShort" Label="Short Test Result" ColumnClass="col-2">
                <select class="form-select" @bind="GroupLogic.FilterShort.Value">
                    <option value="">All Results</option>
                    <option value="UN-T">UN-T</option>
                    <option value="PASS">PASS</option>
                    <option value="FAIL">FAIL</option>
                </select>
            </FilterWrapper>
            <FilterWrapper Filter="GroupLogic.FilterMacro" Label="Macro Test Result" ColumnClass="col-2">
                <select class="form-select" @bind="GroupLogic.FilterMacro.Value">
                    <option value="">All Results</option>
                    <option value="UN-T">UN-T</option>
                    <option value="PASS">PASS</option>
                    <option value="FAIL">FAIL</option>
                </select>
            </FilterWrapper>
            <FilterWrapper Filter="GroupLogic.FilterIC" Label="IC Test Result" ColumnClass="col-2">
                <select class="form-select" @bind="GroupLogic.FilterIC.Value">
                    <option value="">All Results</option>
                    <option value="UN-T">UN-T</option>
                    <option value="PASS">PASS</option>
                    <option value="FAIL">FAIL</option>
                </select>
            </FilterWrapper>
            <FilterWrapper Filter="GroupLogic.FilterFunction" Label="Function Test Result" ColumnClass="col-2">
                <select class="form-select" @bind="GroupLogic.FilterFunction.Value">
                    <option value="">All Results</option>
                    <option value="UN-T">UN-T</option>
                    <option value="PASS">PASS</option>
                    <option value="FAIL">FAIL</option>
                </select>
            </FilterWrapper>
            <div class="col-12 d-flex justify-content-end gap-2">
                <button class="btn btn-outline-secondary" @onclick="ClearFilters">Clear</button>
                @*Have to use parentheses for RefreshData because it takes an argument now (even though it's optional)*@
                <button class="btn btn-primary" @onclick="() => RefreshData()">Execute</button>
            </div>
        </div>
    </div>
</div>

@if (!DataView.Any())
{
    <h4 style="text-align: center;">No group records found matching these criteria.</h4>
}
else
{
    <MasterTable TItem="GroupResult" 
            Items="DataView"
            CurrentPage="Logic.CurrentPage"
            TotalPages="Logic.TotalPages"
            TotalCount="Logic.TotalCount"
            PageSize="Logic.PageSize"
            OnPageChange="ChangePage"
            CurrentSortColumn="@Logic.CurrentSortColumn"
            OnSort="ToggleSort"
            GetSortIcon="GetSortIcon"
            OnSaveToCsv="Logic.SaveToCSV" 
            OnBarcodeClick="Logic.HandleBarcodeClick" />
}

@code {
    /// <summary>
    /// When the page loads, inform LogTableBase that it is a group page
    /// </summary>
    protected override void OnInitialized()
    {
        base.Logic = GroupLogic;
    }
}