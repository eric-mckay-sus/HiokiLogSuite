@page "/group"
@rendermode InteractiveServer
@inject LogDbContext Db

<PageTitle>Group Results</PageTitle>

<h1>Hioki 1220 ICT Group Results</h1>

@if (groupView == null)
{
    <p><em>Loading data from SQL...</em></p>
}
else if (!groupView.Any())
{
    <p>The table is empty.</p>
}
else
{
    <div class="table-container">
        <div class="res-table-wrapper">
            <table class="table res-table table-striped text-nowrap">
                <thead>
                    <tr>
                        <th>Barcode</th>
                        <th>Time</th>
                        <th>Group</th>
                        <th># of times tested</th>
                        <th>allResult</th>
                        <th>componentTest</th>
                        <th>shortTest</th>
                        <th>openTest</th>
                        <th>icTest</th>
                        <th>macroTest</th>
                        <th>functionTest</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (GroupResult item in groupView)
                    {
                        <tr>
                            <td>@item.Barcode</td>
                            <td>@item.Time</td>
                            <td>@item.Group</td>
                            <td>@item.TimesTested</td>
                            <td class="fw-bold">@item.AllResult</td>
                            <td>@item.ComponentTest</td>
                            <td>@item.ShortTest</td>
                            <td>@item.OpenTest</td>
                            <td>@item.IcTest</td>
                            <td>@item.MacroTest</td>
                            <td>@item.FunctionTest</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private List<GroupResult> groupView;

    /// <summary>
    /// When the page is loaded, automatically gets the top 100 group entries in the DB, sorted by time then barcode
    /// </summary>
    /// <returns></returns>
    protected override async Task OnInitializedAsync()
    {
        groupView = await Db.GroupView.OrderBy(g => g.Time).ThenBy(g => g.Barcode).Take(100).ToListAsync();
    }
}

