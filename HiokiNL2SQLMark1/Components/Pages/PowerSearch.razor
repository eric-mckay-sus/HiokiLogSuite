@page "/"
@rendermode InteractiveServer
@inject PowerSearchLogic State
@using Microsoft.IdentityModel.Tokens
@implements IDisposable // for the automatic Dispose method

<PageTitle>@State.LastExecutedQuery</PageTitle>

<h1>Hioki 1220 ICT Power Search</h1>

@if (State.errorMessages != null && State.errorMessages.Count != 0)
{
    @foreach(string message in State.errorMessages){
        bool isWarning = message.Contains("This search", StringComparison.OrdinalIgnoreCase);
        string alertClass = isWarning ? "alert-warning" : "alert-danger";
        string iconClass = isWarning ? "bi-exclamation-triangle" : "bi-exclamation-octagon-fill";

        <div class="alert @alertClass alert-dismissible fade show mb-2" role="alert">
            <strong><i class="bi @iconClass" style="font-size: 1rem;"></i></strong> 
                <span class="d-inline-flex">
                    <Markdown>
                        @((MarkupString)message)
                    </Markdown>
                </span>
            <button type="button" class="btn-close" @onclick="() => State.errorMessages.Remove(message)"></button>
        </div>
    }
}
<div class="command-container mb-4">
    <div class="input-group mb-0">
        <span class="input-group-text bg-dark text-white font-monospace"><i class="bi bi-chevron-right" style="font-size: 1.5rem;"></i></span>
    
        <input type="text" id="searchBar" class="form-control form-control-lg font-monospace" 
            value="@State.commandInput"
            @oninput="State.HandleInput"
            @onkeydown="HandleKeyDown"
            placeholder="Search in @(State.CurrentType.ToUpper())..." />
            @* placeholder="in:group barcode:A100 result:FAIL after:2024-01-01" /> *@

        <span class="input-group-text clear-addon">
            @if (!string.IsNullOrEmpty(State.commandInput))
            {
                <button type="button" class="btn-close" aria-label="Clear" 
                        @onclick="State.ClearSearchBar" 
                        style="font-size: 0.8rem;"></button>
            }
        </span>
        <button class="btn btn-primary px-4 d-flex align-items-center"
                @onclick="async () => await State.ExecutePowerSearch()">
                <i class="bi bi-arrow-right" style="font-size: 1.5rem;"></i></button>
    </div>
    <div class="d-flex gap-2 mt-0 mb-2 filter-row">
        @foreach(string type in SearchParserService.availableTypes){
            <button 
                class="btn btn-sm @(State.CurrentType == type ? "btn-primary" : "btn-outline-secondary")"
                title="Switch to @type @(type=="all" ? "tables" : "table")"
                @onclick='() => State.SetType(type)'>@(char.ToUpper(type[0]) + type[1..])
            </button>
        }
    </div>
    <div class="input-group mb-0">
    </div>
    <div class="mt-1 px-2">
        @if (!string.IsNullOrWhiteSpace(State.Preview))
        {
            <small class="text-muted d-inline-flex">
                <i class="bi bi-search me-1"></i> 
                <Markdown>@((MarkupString)State.Preview)</Markdown>
            </small>
        }
    </div>
    <div class="mt-2">
        <small class="text-muted d-inline-flex align-items-center flex-wrap gap-1">
            <span>Supported keys for this mode:</span>
            @foreach (string key in SearchParserService.GetSupportedKeysThisMode(State.CurrentType))
            {
                <span class="badge @State.GetBadgeClass(key, true) align-middle" 
                    title="@SearchParserService.GetTagTooltip(key, false)"
                    style="cursor: @(State.commandInput.Contains(key, StringComparison.OrdinalIgnoreCase) ? "default" : "pointer");" 
                    @onclick="() => State.AppendKey(key, false)">
                    @key
                    @* If pressing the remove tag button, stop the badge action *@
                    @if(State.commandInput.Contains($"{key}:", StringComparison.OrdinalIgnoreCase)) {
                        <i class="bi bi-x-lg ms-1 remove-pill-btn" 
                        title="Remove filter"
                        @onclick:stopPropagation="true"
                        @onclick="() => State.RemoveTagFromQuery(key)"></i>
                    }
                    </span>
            }
        </small>
    </div>
    <div class="mt-2">
        <small class="text-muted d-inline-flex align-items-center flex-wrap gap-1">
            <span>Date aliases:</span>
            @foreach(string alias in State.dateAliases)
            {
                <span class="badge search-tag secondary align-middle"
                    style="cursor: pointer;"
                    @onclick='() => State.AppendShortcut("after", alias)'>@alias
                </span>
            }
        </small>
    </div>
    
    <div class="mt-2">
        <small class="text-muted d-inline-flex align-items-center flex-wrap gap-1">
            <span>All supported keys:</span>
            @foreach (string key in SearchParserService.AllTags)
            {
                <span @key="key"
                    class="badge @State.GetBadgeClass(key, false) align-middle"
                    title="@SearchParserService.GetTagTooltip(key, true)"
                    style="cursor: help;">
                    @key
                </span>
            }
        </small>
    </div>
</div>

@* If there's a search in progress, show the loading screen *@
@if (State.IsSearching){
    <div class="d-flex flex-column align-items-center my-5">
        <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
            <span class="visually-hidden">Loading...</span>
        </div>
        <h4 class="mt-3 text-muted">@State.Preview.Replace("Showing", "Loading")</h4>
    </div>
} else{
    @* If we have no input, a "no results" message is unhelpful *@
    @if (string.IsNullOrWhiteSpace(State.commandInput) && State.AllCount == 0)
    {
        <div class="text-center my-3 py-3 text-muted">
            <i class="bi bi-search" style="font-size: 3rem;"></i>
            <h3 class="mt-3">Search @($"{State.CurrentType} {(State.CurrentType == "all" ? "tables" : "table")}") </h3>
            <p>Start typing to see a preview of your query below the search bar.</p>
            <div class="d-flex justify-content-center gap-2 mt-3">
                <span class="badge bg-light text-dark border">barcode:A123</span>
                <span class="badge bg-light text-dark border">result:FAIL</span>
                <span class="badge bg-light text-dark border">after:today</span>
            </div>
        </div>
    }
    else if (State.TableLogics != null)
    {
        @* If we have a search with no results at all, say so *@
        @if (State.AllCount == 0 && State.filters?.Count != 0){
            <div class="text-center my-5 py- text-muted">
                <i class="bi bi-clipboard-x" style="font-size: 3rem;"></i>
                <h4 class="mt-3">No results matched these criteria.</h4>
                <p>Try adjusting your filters or checking for typos.</p>
            </div>
        } else { @* Otherwise, go on a by-table basis *@
            @foreach (var logic in State.TableLogics)
            {
                if (logic == null) continue;
                bool isTargeted = State.CurrentType == "all" || State.CurrentType == logic.TableName;
                @* Only show tables that are relevant to the search and have results *@
                if (isTargeted && logic.TotalCount > 0 && State.LastExecutedQuery != "Hioki ICT Power Search")
                {
                    <div class="table-section mb-5">
                        <h2 class="mb-3">@logic.DisplayName</h2>
                        @logic.RenderTable()
                    </div>
                } else if (State.CurrentType != "all" && State.AllCount == 0 && !State.IsSearching && State.LastExecutedQuery != "Hioki ICT Power Search")
                {
                    <h4 style="text-align: center;">No @logic.TableName results matched these criteria.</h4>
                }
            }
        }
    }
}

@code{

    /// <summary>
    /// When the page opens, check the URL for filters.
    /// If there are filters, immediately run a query with them.
    /// </summary>
    /// <returns></returns>
    protected override async Task OnInitializedAsync()
    {
        // Try to get the "q" parameter from the current URI
        Uri? uri = State.NavManager.ToAbsoluteUri(State.NavManager.Uri);

        if (Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query).TryGetValue("q", out var queryVal))
        {
            State.commandInput = queryVal;
            State.SyncLivePreview();
            await State.ExecutePowerSearch(isNavigatingInternal: true, skipUrlUpdate: true);
        }
    }

    /// <summary>
    /// When this page opens, continuously watch the query for filter changes
    /// </summary>
    protected override void OnInitialized()
    {
        State.OnRefreshRequested += HandleRefreshRequested;
    }

    /// <summary>
    /// When this page closes, inform the location manager and kill the timer thread
    /// </summary>
    public void Dispose()
    {
        State.OnRefreshRequested -= HandleRefreshRequested;
        State.DebounceTimer?.Dispose();
    }

    /// <summary>
    /// Helper to bind the enter key to submission when search bar is active
    /// </summary>
    /// <param name="e">the key to handle</param>
    /// <returns></returns>
    public async Task HandleKeyDown(KeyboardEventArgs e){
        if(e.Key == "Enter") await State.ExecutePowerSearch();
    }

    /// <summary>
    /// Check the search bar for filters, then update the URL as necessary
    /// </summary>
    /// <param name="sender">The origin of this call</param>
    /// <param name="e">The information about the event to handle</param>
    public async Task HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if(State.IsProcessingNavigation) return;
        Uri? uri = State.NavManager.ToAbsoluteUri(e.Location);
        var queryParams = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        // If there are query parameters, get them
        if (queryParams.TryGetValue("q", out var queryVal))
        {
            // If the filter state doesn't match the URL, update the search bar
            if (State.commandInput != queryVal)
            {
                await State.UpdateSearchState(queryVal);
            }
        } else {
            // If there aren't query parameters, ensure the search bar is empty
            if(!string.IsNullOrEmpty(State.commandInput)){
                await State.UpdateSearchState(string.Empty);
            }
        }
    }

    /// <summary>
    /// Runs whenever PowerSearchLogic calls NotifyStateChanged()
    /// </summary>
    private void HandleRefreshRequested()
    {
        // We use the Component's InvokeAsync to safely update the UI
        InvokeAsync(StateHasChanged);
    }
}
