@page "/"
@rendermode InteractiveServer
@using Microsoft.IdentityModel.Tokens
@using RegEx = System.Text.RegularExpressions
@using System.Threading.Tasks
@using Microsoft.EntityFrameworkCore
@using System.Text.RegularExpressions
@using System.Timers
@inject IJSRuntime JSRuntime // to handle refocusing the search bar upon selecting a tag
@inject NavigationManager NavManager // to update the URL with filter changes
@inject SearchParserService ParserService // delegate the actual query parsing
@inject HiokiNL2SQLMark1.Logic.GroupTableLogic GroupLogic // model for the group table
@inject HiokiNL2SQLMark1.Logic.StepTableLogic StepLogic // model for the step table
@inject HiokiNL2SQLMark1.Logic.FctTableLogic FctLogic // model for the FCT table
@implements IDisposable // for the automatic Dispose method

<PageTitle>@_lastExecutedQuery</PageTitle>

<h1>Hioki 1220 ICT Power Search</h1>

@if (errorMessages != null && errorMessages.Count != 0)
{
        @foreach(string message in errorMessages){
            <div class="alert alert-warning alert-dismissible fade show mb-2" role="alert">
            <strong><i class="bi bi-exclamation-triangle" style="font-size: 1rem;"></i></strong> @message
            <button type="button" class="btn-close" @onclick="() => errorMessages.Remove(message)"></button>
            </div>
        }
}
<div class="command-container mb-4">
    <div class="input-group mb-0">
        <span class="input-group-text bg-dark text-white font-monospace"><i class="bi bi-chevron-right" style="font-size: 1.5rem;"></i></span>
    
        <input type="text" id="searchBar" class="form-control form-control-lg font-monospace" 
            value="@commandInput"
            @oninput="HandleInput"
            @onkeydown="HandleKeyDown"
            placeholder="Search in @(CurrentType.ToUpper())..." />
            @* placeholder="in:group barcode:A100 result:FAIL after:2024-01-01" /> *@

        <span class="input-group-text clear-addon">
            @if (!string.IsNullOrEmpty(commandInput))
            {
                <button type="button" class="btn-close" aria-label="Clear" 
                        @onclick="ClearSearchBar" 
                        style="font-size: 0.8rem;"></button>
            }
        </span>
        <button class="btn btn-primary px-4 d-flex align-items-center"
                @onclick="async () => await ExecutePowerSearch()">
                <i class="bi bi-arrow-right" style="font-size: 1.5rem;"></i></button>
    </div>
    <div class="d-flex gap-2 mt-0 mb-2 filter-row">
        @foreach(string type in SearchParserService.availableTypes){
            <button 
                class="btn btn-sm @(CurrentType == type ? "btn-primary" : "btn-outline-secondary")"
                title="Switch to @type @(type=="all" ? "tables" : "table")"
                @onclick='() => SetType(type)'>@(char.ToUpper(type[0]) + type[1..])
            </button>
        }
    </div>
    <div class="input-group mb-0">
    </div>
    <div class="mt-1 px-2">
        @if (!string.IsNullOrWhiteSpace(Preview))
        {
            <small class="text-muted">
                <i class="bi bi-search me-1"></i> 
                @((MarkupString)Preview)
            </small>
        }
    </div>
    <div class="mt-2">
        <small class="text-muted d-inline-flex align-items-center flex-wrap gap-1">
            <span>Supported keys for this mode:</span>
            @foreach (string key in SearchParserService.GetSupportedKeysThisMode(CurrentType))
            {
                <span class="badge @GetBadgeClass(key, true) align-middle" 
                    title="@SearchParserService.GetTagTooltip(key, false)"
                    style="cursor: @(commandInput.Contains(key, StringComparison.OrdinalIgnoreCase) ? "default" : "pointer");" 
                    @onclick="() => AppendKey(key, false)">
                    @key
                    @* If pressing the remove tag button, stop the badge action *@
                    @if(commandInput.Contains($"{key}:", StringComparison.OrdinalIgnoreCase)) {
                        <i class="bi bi-x-lg ms-1 remove-pill-btn" 
                        title="Remove filter"
                        @onclick:stopPropagation="true"
                        @onclick="() => RemoveTagFromQuery(key)"></i>
                    }
                    </span>
            }
        </small>
    </div>
    <div class="mt-2">
        <small class="text-muted d-inline-flex align-items-center flex-wrap gap-1">
            <span>Date aliases:</span>
            @foreach(string alias in dateAliases)
            {
                <span class="badge search-tag secondary align-middle"
                    style="cursor: pointer;"
                    @onclick='() => AppendShortcut("after", alias)'>@alias
                </span>
            }
        </small>
    </div>
    
    <div class="mt-2">
        <small class="text-muted d-inline-flex align-items-center flex-wrap gap-1">
            <span>All supported keys:</span>
            @foreach (string key in SearchParserService.AllTags)
            {
                <span @key="key"
                    class="badge @GetBadgeClass(key, false) align-middle"
                    title="@SearchParserService.GetTagTooltip(key, true)"
                    style="cursor: help;">
                    @key
                </span>
            }
        </small>
    </div>
</div>

@* If there's a search in progress, show the loading screen *@
@if (_isSearching){
    <div class="d-flex flex-column align-items-center my-5">
        <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
            <span class="visually-hidden">Loading...</span>
        </div>
        <h4 class="mt-3 text-muted">@Preview.Replace("Showing", "Loading")</h4>
    </div>
} else{
    @* If we have no input, a "no results" message is unhelpful *@
    @if (string.IsNullOrWhiteSpace(commandInput) && AllCount == 0)
    {
        <div class="text-center my-5 py-5 text-muted">
            <i class="bi bi-search" style="font-size: 3rem;"></i>
            <h3 class="mt-3">Search all tables</h3>
            <p>Start typing to see a preview of your query below the search bar.</p>
            <div class="d-flex justify-content-center gap-2 mt-3">
                <span class="badge bg-light text-dark border">barcode:A123</span>
                <span class="badge bg-light text-dark border">result:FAIL</span>
                <span class="badge bg-light text-dark border">after:today</span>
            </div>
        </div>
    }
    @* If we have a search with no results at all, say so *@
    else if (AllCount == 0 && !filters.IsNullOrEmpty()){
        <h4 style="text-align: center;">No results matched these criteria. Please check your filters and spelling.</h4>
    } else { @* Otherwise, go on a by-table basis *@
        @if ((CurrentType == "group" || CurrentType == "all")) {
            @* Then check the results *@
            @if (GroupLogic.DataView.Count > 0){
                <h2>Group Results</h2>
                <MasterTable TItem="GroupResult" Items="GroupLogic.DataView" 
                    CurrentPage="GroupLogic.CurrentPage" TotalPages="GroupLogic.TotalPages" TotalCount="GroupLogic.TotalCount"
                    PageSize="GroupLogic.PageSize" OnPageChange="GroupLogic.ChangePage" OnSort="GroupLogic.ToggleSort"
                    GetSortIcon="GroupLogic.GetSortIcon" OnSaveToCsv="GroupLogic.SaveToCSV" OnBarcodeClick="HandleBarcodeClick" />
            } else {
            <h4 style="text-align: center;">No group results matched these criteria.</h4>
            }
        }
        @if ((CurrentType == "step" || CurrentType == "all")) {
            @if (StepLogic.DataView.Count > 0){
            <h2>Step Results</h2>
            <MasterTable TItem="StepResult" Items="StepLogic.DataView" 
                CurrentPage="StepLogic.CurrentPage" TotalPages="StepLogic.TotalPages" TotalCount="StepLogic.TotalCount"
                PageSize="StepLogic.PageSize" OnPageChange="StepLogic.ChangePage" OnSort="StepLogic.ToggleSort"
                GetSortIcon="StepLogic.GetSortIcon" OnSaveToCsv="StepLogic.SaveToCSV" OnBarcodeClick="HandleBarcodeClick" />
            } else {
            <h4 style="text-align: center;">No step results matched these criteria.</h4>
            }
        }
        @if ((CurrentType == "fct" || CurrentType == "all")) {
            @if (FctLogic.DataView.Count != 0){
            <h2>FCT Results</h2>
            <MasterTable TItem="FctResult" Items="FctLogic.DataView" 
                CurrentPage="FctLogic.CurrentPage" TotalPages="FctLogic.TotalPages" TotalCount="FctLogic.TotalCount"
                PageSize="FctLogic.PageSize" OnPageChange="FctLogic.ChangePage" OnSort="FctLogic.ToggleSort"
                GetSortIcon="FctLogic.GetSortIcon" OnSaveToCsv="FctLogic.SaveToCSV" OnBarcodeClick="HandleBarcodeClick" />
            } else {
            <h4 style="text-align: center;">No FCT results matched these criteria.</h4>
            }
        }
    }
}

@code{
    /// <summary>
    /// The methods and state necessary to run and display a power search
    /// </summary>
    string CurrentType = "all"; // the table to check
    string commandInput = ""; // the input from the search bar
    string Preview = ""; // the human-readable preview of the query to be executed
    List<string> errorMessages = []; // the text of the error message, if applicable
    readonly string[] dateAliases = ["today", "yesterday", "last24h", "shift1", "shift2", "shift3",]; // the list of available date aliases
    Dictionary<string, string>? filters; // the key-value pairs parsed from command input
    private Timer? _debounceTimer; // to smooth the preview rendering
    bool _isProcessingNavigation;
    bool _isSearching;
    int AllCount => GroupLogic.DataView.Count + StepLogic.DataView.Count + FctLogic.DataView.Count;
    string _lastExecutedQuery = "Hioki ICT Power Search";

    /// <summary>
    /// When the page opens, check the URL for filters.
    /// If there are filters, immediately run a query with them.
    /// </summary>
    /// <returns></returns>
    protected override async Task OnInitializedAsync()
    {
        // Try to get the "q" parameter from the current URI
        Uri? uri = NavManager.ToAbsoluteUri(NavManager.Uri);

        if (Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query).TryGetValue("q", out var queryVal))
        {
            commandInput = queryVal;
            SyncLivePreview();
            await ExecutePowerSearch(isNavigatingInternal: true, skipUrlUpdate: true);
        }
    }

    /// <summary>
    /// When this page opens, continuously watch the query for filter changes
    /// </summary>
    protected override void OnInitialized()
    {
        NavManager.LocationChanged += HandleLocationChanged;
    }

    /// <summary>
    /// When this page closes, inform the location manager and kill the timer thread
    /// </summary>
    public void Dispose()
    {
        NavManager.LocationChanged -= HandleLocationChanged;
        _debounceTimer?.Dispose();
    }

    /// <summary>
    /// Check the search bar for filters, then update the URL as necessary
    /// </summary>
    /// <param name="sender">The origin of this call</param>
    /// <param name="e">The information about the event to handle</param>
    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if(_isProcessingNavigation) return;
        Uri? uri = NavManager.ToAbsoluteUri(e.Location);
        var queryParams = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        // If there are query parameters, get them
        if (queryParams.TryGetValue("q", out var queryVal))
        {
            // If the filter state doesn't match the URL, update the search bar
            if (commandInput != queryVal)
            {
                UpdateSearchState(queryVal);
            }
        } else {
            // If there aren't query parameters, ensure the search bar is empty
            if(!string.IsNullOrEmpty(commandInput)){
                UpdateSearchState(String.Empty);
            }
        }
    }

    /// <summary>
    /// Helper to actually execute the new search
    /// </summary>
    /// <param name="newValue">The content to put in the search bar</param>
    private void UpdateSearchState(string newValue)
    {
        commandInput = newValue;
        _ = InvokeAsync(async () => {
            SyncLivePreview();
            await ExecutePowerSearch(isNavigatingInternal: true, skipUrlUpdate: true); 
            StateHasChanged();
        });
    }

    /// <summary>
    /// Parse search bar input, update the model, then tell the view  
    /// </summary>
    /// <returns></returns>
    private async Task ExecutePowerSearch(bool isNavigatingInternal=false, bool skipUrlUpdate=false)
    {
        GroupLogic.ClearData();
        StepLogic.ClearData();
        FctLogic.ClearData();
        var parseResult = ParserService.ParseQuery(commandInput, CurrentType);

        this.filters = parseResult.Filters;
        this.errorMessages = parseResult.ErrorMessages;
        this.CurrentType = parseResult.CurrentType;
        this.Preview = parseResult.Preview;

        if (errorMessages.Count > 0) // if there was an error, don't execute the search
        {
            return;
        }

        if(!skipUrlUpdate){
            _isProcessingNavigation = true;
            try{
                if(!isNavigatingInternal){
                    // Update the URL query string
                    string? newUri = NavManager.GetUriWithQueryParameter("q", string.IsNullOrWhiteSpace(commandInput) ? null : commandInput);

                    // 'false' means don't reload the page, just update the address bar
                    NavManager.NavigateTo(newUri, replace: false);
                } 
            } finally{
                await Task.Yield(); // if something goes wrong, give the browser a second, then unlock navigation
                _isProcessingNavigation=false;
            }
        }

        // Inform the UI that we're loading
        _isSearching = true;
        _lastExecutedQuery = string.IsNullOrWhiteSpace(commandInput) ? "Hioki ICT Power Search" : $"Search: {commandInput}";
        StateHasChanged();

        try{
            List<Task>? tasks = new List<Task>();

            if (CurrentType == "all" || CurrentType == "group"){
                tasks.Add(GroupLogic.ApplyFiltersFromDictionary(filters));
            } 
            if (CurrentType == "all" || CurrentType == "step"){
                tasks.Add(StepLogic.ApplyFiltersFromDictionary(filters));
            }
            if (CurrentType == "all" || CurrentType == "fct"){
                tasks.Add(FctLogic.ApplyFiltersFromDictionary(filters));
            }
            await Task.WhenAll(tasks);
        } catch (Exception ex){
            errorMessages.Add($"Search failed: {ex.Message}");
        } finally{
            _isSearching = false;
            StateHasChanged();
        }
        StateHasChanged();
    }

    /// <summary>
    /// Helper to append the datetime associated with a date shortcut to keep AppendKey for key checking only
    /// </summary>
    /// <param name="key">The key to append</param>
    /// <param name="shortcut">The shortcut to append</param>
    /// <returns></returns>
    private async Task AppendShortcut(string key, string shortcut)
    {
        string toAppend = $"{key}:{shortcut} ";
        // Short-circuit if search bar is empty
        if(string.IsNullOrEmpty(commandInput)){
            commandInput = toAppend;
            await JSRuntime.InvokeVoidAsync("focusElement", "searchBar");
            return;
        }

        // If the shortcut is already touching a tag or the key/shortcut is already present in the search bar, only add the shortcut
        if (commandInput.Contains(shortcut) || commandInput.Contains(key) || commandInput.TrimEnd()[^1] == ':'){
            toAppend = $"{shortcut} ";
        } else { // technically unnecessary bc the parser is smart enough but it's easier to read
            toAppend = ' ' + toAppend;
        }

        // Append the shortcut
        commandInput = commandInput.TrimEnd() + toAppend;
        SyncLivePreview();
        await JSRuntime.InvokeVoidAsync("focusElement", "searchBar");
    }

    /// <summary>
    /// Helper for quick select table tabs. Automatically runs
    /// </summary>
    /// <param name="toType">The target table</param>
    private async Task SetType(string toType){
        if(commandInput.Contains($"in:{CurrentType}",StringComparison.OrdinalIgnoreCase)){ // if the search already has an "in" tag, replace it
            commandInput = Regex.Replace(commandInput, ParserService.inPattern, $"in:{toType}", RegexOptions.IgnoreCase);
        } else { // otherwise, just append it
            await AppendKey("in", true);
            commandInput += toType;
        }
        CurrentType = toType;
        // If the user is currently viewing a search result or has something in the search bar, they probably want to search now
        if (AllCount > 0 || !commandInput.IsNullOrEmpty()){
            await ExecutePowerSearch();
        }
        SyncLivePreview();
    } 

    /// <summary>
    /// Helper for search bar X button
    /// </summary>
    private void ClearSearchBar(){
        commandInput = "";
        SyncLivePreview();
    }

    /// <summary>
    /// Helper to bind the enter key to submission when search bar is active
    /// </summary>
    /// <param name="e">the key to handle</param>
    /// <returns></returns>
    private async Task HandleKeyDown(KeyboardEventArgs e){
        if(e.Key == "Enter") await ExecutePowerSearch();
    }

    /// <summary>
    /// Manage the debounce timer and notify the preview
    /// </summary>
    /// <param name="e">Detects a change in input</param>
    private void HandleInput(ChangeEventArgs e){
        commandInput = e.Value?.ToString() ?? "";

        // Stop the old (if there is one)
        if (_debounceTimer != null) {
            _debounceTimer.Stop();
            _debounceTimer.Dispose();
        }

        // Start the new
        _debounceTimer = new Timer(300);
        _debounceTimer.Elapsed += OnUserStoppedTyping;
        _debounceTimer.AutoReset = false;
        _debounceTimer.Start();
    }

    /// <summary>
    /// As the user types, get the interpretation of their search
    /// </summary>
    /// <param name="sender"></param>
    /// <param name="e"></param>
    private void OnUserStoppedTyping(object? sender, ElapsedEventArgs e)
    {
        // Timer runs on a background thread, so use InvokeAsync to update the UI thread.
        InvokeAsync(() =>
        {
            var liveResult = ParserService.ParseQuery(commandInput, CurrentType);
            this.Preview = liveResult.Preview;

            // Update the CurrentType if the user entered the "in" tag
            if (!string.IsNullOrEmpty(liveResult.CurrentType)) 
                CurrentType = liveResult.CurrentType;

            StateHasChanged();
        });
    }

    /// <summary>
    /// Updates the live preview based on current search bar contents
    /// </summary>
    private void SyncLivePreview()
    {
        var liveResult = ParserService.ParseQuery(commandInput, CurrentType);
        this.Preview = liveResult.Preview;
    }

    /// <summary>
    /// Toggles color depending on whether the input key is present in the search bar
    /// </summary>
    /// <param name="key">The tag to check against the search bar contents</param>
    /// <param name="thisMode">Whether the tag is active in this mode (lighter styling)</param>
    /// <returns>The badge style reflecting its activation state</returns>
    private string GetBadgeClass(string key, bool thisMode){
        // Highlight red for negative presence (-key:)
        if (commandInput.Contains($"-{key}:", StringComparison.OrdinalIgnoreCase))
        {
            return thisMode ? "search-tag is-active negative" : "search-tag is-active-tertiary negative";
        }

        // Highlight blue for positive presence (key:)
        if (commandInput.Contains($"{key}:", StringComparison.OrdinalIgnoreCase))
        {
            return thisMode ? "search-tag is-active" : "search-tag is-active-tertiary";
        }

        // Otherwise, revert to respective default (inactive) states
        return thisMode ? "search-tag secondary" : "search-tag tertiary";
    }

    /// <summary>
    /// Removes a key and its associated value from the query
    /// </summary>
    /// <param name="key">The key to remove the tag for</param>
    /// <returns></returns>
    private void RemoveTagFromQuery(string key)
    {
        if (string.IsNullOrWhiteSpace(commandInput)) return; // in the case this method is somehow triggered without any filters

        // Pattern handles: -?key: followed by ("quoted value" OR unquotedValue)
        string pattern = $@"-?{key}:(""[^""]*""|[^\s]*)";

        commandInput = Regex.Replace(commandInput, pattern, "", RegexOptions.IgnoreCase).Trim();

        // Clean up double spaces that might be left behind
        commandInput = Regex.Replace(commandInput, @"\s+", " ");

        // Sync the preview and re-execute search to update the DataViews
        SyncLivePreview();

        // If the input is now empty, clear the results entirely
        if (string.IsNullOrEmpty(commandInput))
        {
            GroupLogic.ClearData();
            StepLogic.ClearData();
            FctLogic.ClearData();
        }
    }

    /// <summary>
    /// Appends the input key to the search bar if not currently there
    /// </summary>
    /// <param name="key">The tag to be appended to the search</param>
    /// <param name="fromTableTab">whether this call is from a table tab (or from the quick select options)</param>
    /// <returns>Whether the key was appended (or if it was already in the </returns>
    private async Task<bool> AppendKey(string key, bool fromTableTab)
    {
        // Check if the key is already present (case-insensitive)
        if (commandInput.Contains(key, StringComparison.OrdinalIgnoreCase))
        {
            return false; // Do nothing; we don't want to duplicate it
        }

        // If the search bar is currently empty, append right away, otherwise ensure there is a space between the current last character and the key
        commandInput = string.IsNullOrWhiteSpace(commandInput) ? $"{key}:" : $"{commandInput.TrimEnd()} {key}:";

        // Trigger the JS helper to put the cursor back in the box if using quick select options
        if(!fromTableTab){ 
            await JSRuntime.InvokeVoidAsync("focusElement", "searchBar");
        }
        SyncLivePreview();
        return true;
    }

    /// <summary>
    /// Traces a barcode through all tables
    /// </summary>
    /// <param name="barcode">The barcode to trace</param>
    /// <returns></returns>
    private async Task HandleBarcodeClick(string barcode)
    {
        commandInput = $"in:all barcode:{barcode}";
        SyncLivePreview();
        await ExecutePowerSearch(); // This triggers the search immediately
    }
}
