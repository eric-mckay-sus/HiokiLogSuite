@inject PowerSearchLogic State

@if (State.errorMessages != null && State.errorMessages.Any())
{
    @foreach(string message in State.errorMessages){
        bool isWarning = message.Contains("This search", StringComparison.OrdinalIgnoreCase);
        string alertClass = isWarning ? "alert-warning" : "alert-danger";
        string iconClass = isWarning ? "bi-exclamation-triangle" : "bi-exclamation-octagon-fill";

        <div class="alert @alertClass alert-dismissible fade show mb-2" role="alert">
            <strong><i class="bi @iconClass" style="font-size: 1rem;"></i></strong> 
                <span class="d-inline-flex">
                    <Markdown>
                        @((MarkupString)message)
                    </Markdown>
                </span>
            <button type="button" class="btn-close" @onclick="() => State.errorMessages.Remove(message)"></button>
        </div>
    }
}

@code {
    [Parameter] public List<string> Messages { get; set; } = new();

    private void RemoveMessage(string message){
        Messages.Remove(message);
        State.NotifyStateChanged();
    }
}