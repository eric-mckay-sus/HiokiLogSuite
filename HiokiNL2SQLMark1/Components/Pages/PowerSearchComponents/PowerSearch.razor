@page "/"
@rendermode InteractiveServer
@inject PowerSearchLogic State
@inject INavService NavService
@implements IDisposable // for the automatic Dispose method

<PageTitle>@State.LastExecutedQuery</PageTitle>

<h1>Hioki 1220 ICT Power Search</h1>

<ErrorDisplay Messages="State.errorMessages" />

<div class="command-container mb-4">
    <SearchBar />
    <Preview />
    <SearchTags />
</div>

<SearchResults />

@code{

    /// <summary>
    /// When the page opens, check the URL for filters, sorts, and pagination.
    /// If there are filters, immediately run a query with them.
    /// </summary>
    /// <returns></returns>
    protected override async Task OnInitializedAsync()
    {
        string? currentQuery = NavService.GetCurrentQuery();
        
        if (!string.IsNullOrEmpty(currentQuery))
        {
            // Update logic state from URL (Initial Load)
            await ApplyUrlState();
        }
    }

    /// <summary>
    /// When this page opens, continuously watch the query for filter changes
    /// </summary>
    protected override void OnInitialized()
    {
        State.OnRefreshRequested += HandleRefreshRequested;
        NavService.OnLocationChanged += HandleLocationChanged;
    }

    /// <summary>
    /// When this page closes, inform the viewmodel and location manager, then kill the timer thread
    /// </summary>
    public void Dispose()
    {
        State.OnRefreshRequested -= HandleRefreshRequested;
        NavService.OnLocationChanged -= HandleLocationChanged;
        State.DebounceTimer?.Dispose();
    }

    /// <summary>
    /// Runs whenever PowerSearchLogic calls NotifyStateChanged()
    /// </summary>
    private void HandleRefreshRequested() => InvokeAsync(StateHasChanged);

    /// <summary>
    /// Check the search bar for filters, then update the URL as necessary
    /// </summary>
    /// <param name="sender">The origin of this call</param>
    /// <param name="e">The information about the event to handle</param>
    public async void HandleLocationChanged(string newLocation)
    {
        try{
            if (State.IsProcessingNavigation) return;

            await InvokeAsync(async () =>
            {
                await ApplyUrlState();
                StateHasChanged();
            });
        }
        catch (Exception ex)
        {
            // Log error or update UI state - async void must handle its own errors!
            Console.WriteLine($"Navigation error: {ex.Message}");
        }
        
    }

    private async Task ApplyUrlState()
    {
        UrlState? state = NavService.GetFullStateFromUrl();
        State.commandInput = state.Query;
        
        var activeTable = State.TableLogics.FirstOrDefault(t => 
        t.TableName.Equals(State.CurrentType, StringComparison.OrdinalIgnoreCase));

        if (activeTable != null)
        {
            activeTable.CurrentPage = state.Page ?? 1;
            activeTable.PageSize = state.PageSize ?? 50;
            activeTable.CurrentSortColumn = state.SortCol ?? "";
            activeTable.SortDir = state.SortDir ?? "none";
        }

        // Execute the search (passing true to keepPage ensures we use the URL's page number)
        await State.ExecutePowerSearch(skipUrlUpdate: true, keepPage: true);
    }
}
