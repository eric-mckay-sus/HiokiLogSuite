@implements IDisposable

<div class="mt-1 px-2">
        @if (!string.IsNullOrWhiteSpace(State.Preview))
        {
            <small class="text-muted d-inline-flex">
                <i class="bi bi-search me-1"></i> 
                <Markdown>@((MarkupString)State.Preview)</Markdown>
            </small>
        }
    </div>

@code {
    [CascadingParameter]
    public PowerSearchLogic State { get; set; } = default!;
    
    protected override void OnInitialized()
    {
        // Listen for changes from the SearchBar so we can update highlights
        State.OnRefreshRequested += HandleRefreshRequested;
    }
    private void HandleRefreshRequested() => InvokeAsync(StateHasChanged);
    public void Dispose()
    {
        State.OnRefreshRequested -= HandleRefreshRequested;
    }
}