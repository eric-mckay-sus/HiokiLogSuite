@implements IDisposable

@* If there's a search in progress, show the loading screen *@
@if (State.IsSearching){
    <div class="d-flex flex-column align-items-center my-5">
        <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
            <span class="visually-hidden">Loading...</span>
        </div>
        <Markdown Class="mt-3 text-muted">@(State.Preview.Replace("Showing", "Loading"))</Markdown>
    </div>
} else{
    @* If we have no input, a "no results" message is unhelpful *@
    @if (string.IsNullOrWhiteSpace(State.commandInput) && State.AllCount == 0)
    {
        <div class="text-center my-3 py-3 text-muted">
            <i class="bi bi-search" style="font-size: 3rem;"></i>
            <h3 class="mt-3">Search @($"{State.CurrentType} {(State.CurrentType == "all" ? "tables" : "table")}") </h3>
            <p>Start typing to see a preview of your query below the search bar.</p>
            <div class="d-flex justify-content-center gap-2 mt-3">
                <span class="badge bg-light text-dark border">barcode:A123</span>
                <span class="badge bg-light text-dark border">result:FAIL</span>
                <span class="badge bg-light text-dark border">after:today</span>
            </div>
        </div>
    }
    List<ILogTableLogic>? targetedTables = State.TableLogics
            .Where(t => State.CurrentType == "all" || State.CurrentType.Equals(t.TableName, StringComparison.OrdinalIgnoreCase))
            .ToList();

        int totalTargetedResults = targetedTables.Sum(t => t.TotalCount);

        @if (totalTargetedResults == 0 && State.LastExecutedQuery != "Hioki ICT Power Search") {
            <div class="text-center my-5 py-5 text-muted">
                <i class="bi bi-clipboard-x" style="font-size: 3.75rem;"></i>
                <h3 class="mt-2">
                    No @(State.CurrentType == "all" ? "" : State.CurrentType) results matched these criteria.
                </h3>
                <p style="font-size: 1.1rem">Try adjusting your filters or checking for typos.</p>
            </div>
        }
        else {
            @foreach (ILogTableLogic logic in targetedTables) {
                @if(logic.TotalCount > 0){
                    <div @key="logic.TableName + State.LastExecutedQuery" class="table-section mb-5">
                        <h2 class="mb-3">@logic.DisplayName</h2>
                        @if (logic is LogTableLogic<GroupResult> groupLogic) {
                        <LogTablePresenter T="GroupResult" TableLogic="groupLogic" />
                        }
                        else if (logic is LogTableLogic<StepResult> stepLogic) {
                            <LogTablePresenter T="StepResult" TableLogic="stepLogic" />
                        }
                        else if (logic is LogTableLogic<FctResult> fctLogic) {
                            <LogTablePresenter T="FctResult" TableLogic="fctLogic" />
                        }
                    </div>
                }
            }
        }
    }

@code {
    [CascadingParameter]
    public PowerSearchLogic State { get; set; } = default!;
    
    protected override void OnInitialized()
    {
        // Listen for changes from the SearchBar so we can update highlights
        State.OnRefreshRequested += HandleRefreshRequested;
    }
    private void HandleRefreshRequested() => InvokeAsync(StateHasChanged);
    public void Dispose()
    {
        State.OnRefreshRequested -= HandleRefreshRequested;
    }
}