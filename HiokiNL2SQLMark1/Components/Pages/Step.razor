@page "/step"
@using Parser = HiokiNL2SQLMark1.Services.SearchParserService
@rendermode InteractiveServer
@inherits LogTableBase<StepResult> // Step table is the page type
@inject Logic.StepTableLogic StepLogic // The page is controlled by step logic

<PageTitle>Hioki ICT Step Results</PageTitle>

<h1>Hioki 1220 ICT Step Test Results</h1>

@* Query Builder Panel *@
<div class="page-content-wrapper" style="max-width: 100%; overflow-x: hidden;">
    <div class="query-builder-panel mb-4 p-3 border rounded bg-light">
        <div class="row g-3">
            @* div class col-____ tells Blazor it can use ____ columns out of 12 *@
            <FilterWrapper Filter="FilterBarcode" Label="Barcode" ColumnClass="col-4">
                <input type="text" class="form-control" @bind-value="FilterBarcode.Value" @bind-value:event="oninput" placeholder="Scan or type..." />
            </FilterWrapper>
            <div class="col-3">
                <label class="form-label fw-bold">Start Date</label>
                <div class="input-group">
                    <input type="date" class="form-control" @bind="_startDatePart" @bind:after="UpdateStart" />
                    <select class="form-select" @bind="_startTimePart" @bind:after="UpdateStart">
                        <option value="">All Shifts</option>
                        @foreach (string shift in Parser.shiftDetails.Keys)
                        {
                            <option value="@shift">@shift</option>
                        }
                    </select>
                </div>
            </div>
            <div class="col-3">
                <label class="form-label fw-bold">End Date</label>
                <div class="input-group">
                    <input type="date" class="form-control" @bind="_endDatePart" @bind:after="UpdateEnd" />
                    <select class="form-select" @bind="_endTimePart" @bind:after="UpdateEnd">
                        <option value="">All Shifts</option>
                        @foreach (string shift in Parser.shiftDetails.Keys)
                        {
                            <option value="@shift">@shift</option>
                        }
                    </select>
                </div>
            </div>
            <FilterWrapper Filter="FilterGroup" Label="Group #" ColumnClass="col-1">
                <input type="number" class="form-control" step="1" @bind-value="FilterGroup.Value" @bind-value:event="oninput" />
            </FilterWrapper>
            <FilterWrapper Filter="FilterStep" Label="Step #" ColumnClass="col-1">
                <input type="number" class="form-control" step="1" @bind-value="FilterStep.Value" @bind-value:event="oninput" />
            </FilterWrapper>
            <FilterWrapper Filter="FilterPartName" Label="Part Name" ColumnClass="col-2">
                <input type="text" class="form-control" @bind-value="FilterPartName.Value" @bind-value:event="oninput" placeholder="e.g. R301..." />
            </FilterWrapper>
            <FilterWrapper Filter="FilterMode" Label="Test Mode" ColumnClass="col-2">
                <select class="form-select" @bind="FilterMode.Value">
                    <option value="">All Modes</option>
                    @foreach (string? m in Logic.ModeCache)
                    {
                        <option value="@m">@m</option>
                    }
                </select>
            </FilterWrapper>
            <FilterWrapper Filter="FilterResult" Label="Result" ColumnClass="col-2">
                <select class="form-select" @bind="FilterResult.Value">
                    <option value="">All Results</option>
                    @foreach (string? r in Logic.ResultCache)
                    {
                        <option value="@r">@r</option>
                    }
                </select>
            </FilterWrapper>
            <div class="col-12 d-flex justify-content-end gap-2">
                <div class="ms-auto btn-group btn-group-sm" role="group">
                    <input type="radio" class="btn-check" name="incl" id="incl_on" autocomplete="off" 
                        checked="@_isInclusive" 
                        @onchange="() => SetInclusivity(true)">
                    <label class="btn btn-outline-primary d-inline-flex align-items-center" for="incl_on">Inclusive [ ]</label>

                    <input type="radio" class="btn-check" name="incl" id="incl_off" autocomplete="off" 
                        checked="@(!_isInclusive)" 
                        @onchange="() => SetInclusivity(false)">
                    <label class="btn btn-outline-primary d-inline-flex align-items-center" for="incl_off">Exclusive ( )</label>
                </div>
                <button class="btn btn-outline-secondary" @onclick="ClearFilters">Clear</button>
                <button class="btn btn-primary" @onclick="() => RefreshData()">Execute</button>
            </div>
        </div>
    </div>
</div>

<LogTablePresenter T="StepResult" TableLogic="StepLogic" />

@code {
    private Filter<string?> FilterPartName => Logic.GetFilter<string?>("part");
    private Filter<int?> FilterStep => Logic.GetFilter<int?>("step");
    private Filter<string?> FilterMode => Logic.GetFilter<string?>("mode");

    /// <summary>
    /// When the page is opened, tell LogTableBase that it is a step table page
    /// </summary>
    protected override void OnInitialized()
    {
        base.Logic = StepLogic;
        Logic.OnNotifyUI = () => InvokeAsync(StateHasChanged);
    }
}