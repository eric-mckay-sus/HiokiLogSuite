@page "/step"
@rendermode InteractiveServer
@inherits LogTableBase<StepResult>

<PageTitle>Step Results</PageTitle>

<div class="page-container">
<h1>Hioki 1220 ICT Step Test Results</h1>

@* Query Builder Panel *@
<div class="page-content-wrapper" style="max-width: 100%; overflow-x: hidden;">
    <div class="query-builder-panel mb-4 p-3 border rounded bg-light">
        <div class="row g-3 m-0">
            @* div class col-____ tells Blazor it can use ____ columns out of 12 *@
            <div class="col-4"> 
                <label class="form-label fw-bold">Barcode</label>
                <input type="text" class="form-control" @bind="Logic.FilterBarcode" placeholder="Scan or type..." />
            </div>
            <div class="col-2">
                <label class="form-label fw-bold">Start Date</label>
                <input type="date" class="form-control" @bind="Logic.FilterStartDate" />
            </div>
            <div class="col-2">
                <label class="form-label fw-bold">End Date</label>
                <input type="date" class="form-control" @bind="Logic.FilterEndDate" />
            </div>
            <div class="col-1">
                <label class="form-label fw-bold">Group</label>
                <input type="number" class="form-control" step="1" @bind="Logic.FilterGroup" />
            </div>
            <div class="col-1">
                <label class="form-label fw-bold">Step</label>
                <input type="number" class="form-control" step="1" @bind="FilterStep" />
            </div>
            <div class="col-2">
                <label class="form-label fw-bold">Part Name</label>
                <input type="text" class="form-control" @bind="FilterPartName" placeholder="e.g. 30AA..." />
            </div>
            <div class="col-2">
                <label class="form-label fw-bold">Mode</label>
                <select class="form-select" @bind="FilterMode">
                    <option value="">All Modes</option>
                    @foreach (string? m in Logic.modeCache)
                    {
                        <option value="@m">@m</option>
                    }
                </select>
            </div>
            <div class="col-2">
                <label class="form-label fw-bold">Result</label>
                <select class="form-select" @bind="Logic.FilterResult">
                    <option value="">All Results</option>
                    @foreach (string? r in Logic.resultCache)
                    {
                        <option value="@r">@r</option>
                    }
                </select>
            </div>
            <div class="col-12 d-flex justify-content-end gap-2">
                <button class="btn btn-outline-secondary" @onclick="ClearFilters">Clear</button>
                <button class="btn btn-primary" @onclick="() => RefreshData()">Execute</button>
            </div>
        </div>
    </div>
</div>

@if (DataView == null)
{
    <p><em>Loading data from SQL...</em></p>
}
else if (!DataView.Any())
{
    <p>No step records found matching these criteria.</p>
}
else
{
    <MasterTable TItem="StepResult" 
              Items="DataView"
              CurrentPage="Logic.CurrentPage"
              TotalPages="Logic.TotalPages"
              TotalCount="Logic.TotalCount"
              PageSize="Logic.PageSize"
              OnPageChange="ChangePage"
              CurrentSortColumn="@Logic.CurrentSortColumn"
              OnSort="ToggleSort"
              GetSortIcon="GetSortIcon" />
}
</div>

@code {
    // Step-table specific filters
    private string? FilterPartName;
    private int? FilterStep;
    private string? FilterMode;

    /// <summary>
    /// When the page loads, check the available result types and modes, then perform the default query
    /// </summary>
    /// <returns></returns>
    protected override async Task OnInitializedAsync()
    {
        base.OnInitialized();
        await RefreshData();
    }

    /// <summary>
    /// Sets the base query to StepView so LogTableBase.cs can take over
    /// </summary>
    /// <returns>A fresh IQueryable<StepResult></returns>
    protected override IQueryable<StepResult> GetBaseQuery(LogDbContext db) => db.StepView;
    
    /// <summary>
    /// Applies step table specific filters (i.e. step number, part name, and test mode)
    /// </summary>
    /// <param name="query">The query to which the filters should be appended</param>
    /// <returns>An IQueryable<StepResult> with filters applied</returns>
    protected override IQueryable<StepResult> ApplyFilters(IQueryable<StepResult> query)
    {
        query = base.ApplyFilters(query);
        if (FilterStep != null){
            query = query.Where(s => s.Step == FilterStep);
        }
        if (!string.IsNullOrWhiteSpace(FilterPartName)){
            query = query.Where(s => s.PartName.Contains(FilterPartName));
        }
        if (!string.IsNullOrWhiteSpace(FilterMode)){
            query = query.Where(s => s.Mode.Contains(FilterMode));
        }
        return query;
    }

    /// <summary>
    /// Sets filters to their default values
    /// </summary>
    /// <returns></returns>
    protected override async Task ClearFilters()
    {
        await base.ClearFilters();
        FilterPartName = null;
        FilterMode = null;
        FilterStep = null;
        await RefreshData();
    }
}