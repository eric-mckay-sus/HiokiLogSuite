@page "/step"
@inject LogDbContext Db

<PageTitle>Step Results</PageTitle>

<h1>Hioki 1220 ICT Step Test Results</h1>

@if (stepView == null)
{
    <p><em>Loading data from SQL...</em></p>
}
else if (!stepView.Any())
{
    <p>The table is empty.</p>
}
else
{
    <div class="table-container">
        <div class="res-table-wrapper">
            <table class="table res-table table-striped text-nowrap">
                <thead>
                    <tr>
                        <th>Barcode</th>
                        <th>Time</th>
                        <th>Group</th>
                        <th>Step</th>
                        <th># of times tested</th>
                        <th>Result</th>
                        <th>Part Name</th>
                        <th>High-pin</th>
                        <th>Low-pin</th>
                        <th>Part position</th>
                        <th>Mode</th>
                        <th>Measurement range</th>
                        <th>High limit</th>
                        <th>Low limit</th>
                        <th>Actual (mounted) value</th>
                        <th>Reference value</th>
                        <th>Measurement value</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (StepResult item in stepView)
                    {
                        <tr>
                            <td>@item.Barcode</td>
                            <td>@item.Time</td>
                            <td>@item.Group</td>
                            <td>@item.Step</td>
                            <td>@item.TimesTested</td>
                            <td class="fw-bold">@item.Result</td>
                            <td>@item.PartName</td>
                            <td>@item.HighPin</td>
                            <td>@item.LowPin</td>
                            <td>@item.Position</td>
                            <td>@item.Mode</td>
                            <td>@item.MeasRange</td>
                            <td class="text-numeric">@item.HighLim</td>
                            <td class="text-numeric">@item.LowLim</td>
                            <td class="text-numeric">@item.ActualVal</td>
                            <td class="text-numeric">@item.RefVal</td>
                            <td class="text-numeric">@item.MeasVal</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private List<StepResult> stepView;

    /// <summary>
    /// When the page is loaded, automatically gets the top 100 step entries in the DB, sorted by group then step
    /// </summary>
    /// <returns></returns>
    protected override async Task OnInitializedAsync()
    {
        stepView = await Db.StepView.OrderBy(s => s.Group).ThenBy(s => s.Step).Take(100).ToListAsync();
    }
}

